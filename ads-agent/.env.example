# Gemini on Vertex AI, authenticated with Application Default Credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global

# Model for the agent (optional).
ADS_AGENT_MODEL=gemini-3.8-flash

# Directory the skills read and write (media/, brand_assets/, specs). Defaults to the current directory.
ADS_AGENT_WORKSPACE=/path/to/your/site/repo

# Model Armor template that screens messages, replies, web pages, and files (optional; create it with
# scripts/setup_model_armor.py). Unset to turn screening off.
# ADS_AGENT_MODEL_ARMOR_TEMPLATE=projects/your-project-id/locations/us-central1/templates/ads-agent

# Cloud Storage location for specs, media, brand assets, and uploads ($W in the skills).
# Unset to keep them in the workspace.
# ADS_AGENT_STORAGE=gs://your-workspace-bucket

# Google Ads API config for search_search and the skill scripts (optional, default ~/google-ads.yaml).
# GOOGLE_ADS_CONFIGURATION_FILE_PATH=~/google-ads.yaml

# genmedia MCP servers (optional). Unset GENMEDIA_BUCKET to leave them out.
GENMEDIA_BIN_DIR=~/.local/bin
GENMEDIA_BUCKET=your-genmedia-bucket
